{
  "name": "imai-laboratory-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "prepare": "panda codegen"
  },
  "dependencies": {
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.2.0",
    "@pandacss/preset-base": "^2.2.0",
    "@pandacss/preset-panda": "^2.2.0",
    "@pandacss/vite": "^2.2.0",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "latest",
    "typescript": "latest",
    "vite-plus": "1.3.0",
    "vue-tsc": "latest"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
    }
  }
}
