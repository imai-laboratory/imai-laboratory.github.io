{
  "name": "imai-laboratory-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "prepare": "panda codegen && lefthook install"
  },
  "dependencies": {
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.6.0",
    "@pandacss/preset-base": "^2.6.0",
    "@pandacss/preset-panda": "^2.6.0",
    "@pandacss/vite": "^2.6.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "lefthook": "^2.2.2",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
